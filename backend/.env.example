# MySQL (production):  mysql+pymysql://riskuser:StrongPass@localhost:3306/riskdb
DATABASE_URL=sqlite:///./riskapp.db
SECRET_KEY=replace-with-a-long-random-string
ADMIN_EMAIL=admin@riskapp.local
ADMIN_PASSWORD=Admin@12345
CORS_ORIGINS=http://localhost:5173
# Optional external AI. An Anthropic Console API key is separate from a Claude website subscription.
# Leave AI_PROVIDER empty for built-in FAQ/assessment explanations only.
# To enable conversational AI, set AI_PROVIDER=anthropic and add your API key below.
AI_PROVIDER=
AI_API_KEY=
AI_MODEL=claude-haiku-4-5-20251001

# Required for public signup email verification (SMTP STARTTLS, commonly port 587).
# Gmail requires a Google App Password; use your mailbox address as SMTP_USERNAME and SMTP_FROM_EMAIL.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-16-character-app-password
SMTP_FROM_EMAIL=your-email@gmail.com
SMTP_USE_TLS=true
SIGNUP_OTP_TTL_MINUTES=10
SIGNUP_OTP_RESEND_SECONDS=60
